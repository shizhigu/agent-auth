# Copy to `.env` (or just `export` these in your shell).

# Postgres / Redis from docker-compose.yml.
DATABASE_URL=postgres://postgres:postgres@localhost:55432/agent_auth_demo
REDIS_URL=redis://localhost:56379

# Internal HMAC secret — 32 random bytes, base64. For real deployments this
# is provisioned via KMS / SSM. For the demo, any 32-byte value is fine; the
# stub identity provider doesn't sign anything.
AGENT_AUTH_INTERNAL_SECRET=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# SaaS port the agent will hit.
SAAS_PORT=3000

# Demo agent target.
SAAS_BASE_URL=http://localhost:3000
