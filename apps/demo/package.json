{
  "name": "vouch-demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "End-to-end demo of Vouch — a minimal SaaS + a Node agent that registers and calls protected APIs.",
  "scripts": {
    "setup-db": "bash scripts/setup-db.sh",
    "saas": "tsx saas/server.ts",
    "agent": "tsx agent/run.ts",
    "demo": "echo 'Run `npm run saas` in one terminal and `npm run agent` in another.'"
  },
  "dependencies": {
    "@vouch/server": "*",
    "@aws-sdk/client-kms": "^3.600.0",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "libsodium-wrappers": "0.7.15",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^25.6.2",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.2",
    "typescript": "^5.4.5"
  }
}
