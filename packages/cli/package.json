{
  "name": "@vouch/cli",
  "version": "0.2.0",
  "description": "Vouch — command-line tooling. `vouch migrate up/down/status` plus `vouch dev` for the local docker stack.",
  "keywords": [
    "vouch",
    "agent-auth",
    "cli",
    "migrations",
    "postgres"
  ],
  "license": "MIT",
  "author": "Agentic Flow LLC",
  "homepage": "https://github.com/shizhigu/agent-auth/tree/main/packages/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shizhigu/agent-auth.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/shizhigu/agent-auth/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "vouch": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./migrate": {
      "types": "./dist/migrate.d.ts",
      "import": "./dist/migrate.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vouch/server": "*",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.6",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
