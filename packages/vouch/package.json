{
  "name": "@vouch/server",
  "version": "0.2.0",
  "description": "Vouch — identity infrastructure for AI agents. Drop-in auth rail that sits next to your existing human auth, never replaces it.",
  "keywords": [
    "ai-agents",
    "agent-auth",
    "vouch",
    "authentication",
    "authorization",
    "api-keys",
    "oauth",
    "github-app",
    "audit-log",
    "kms",
    "hmac",
    "libsodium",
    "rate-limiting",
    "postgres",
    "redis",
    "typescript",
    "security",
    "saas"
  ],
  "license": "MIT",
  "author": "Agentic Flow LLC",
  "homepage": "https://github.com/shizhigu/agent-auth#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shizhigu/agent-auth.git"
  },
  "bugs": {
    "url": "https://github.com/shizhigu/agent-auth/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/middleware/express-adapter.d.ts",
      "import": "./dist/middleware/express-adapter.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "import": "./dist/hono.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "schema",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ../../examples/tsconfig.examples.json",
    "test": "vitest run --config vitest.unit.config.ts",
    "test:watch": "vitest --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:chaos": "vitest run --config vitest.chaos.config.ts",
    "bench": "vitest bench --run --config vitest.bench.config.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1058.0",
    "@aws-sdk/client-s3": "^3.1058.0",
    "@octokit/auth-app": "^7.1.0",
    "ioredis": "^5.11.0",
    "libsodium-wrappers": "^0.8.4",
    "pg": "^8.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.14.0",
    "@testcontainers/redis": "^11.14.0",
    "@types/express": "^4.17.21",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.6",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "aws-sdk-client-mock": "^4.1.0",
    "eslint": "^8.57.0",
    "express": "^4.19.2",
    "fast-check": "^4.7.0",
    "hono": "^4.4.13",
    "testcontainers": "^11.14.0",
    "toxiproxy-node-client": "^4.1.0",
    "tsx": "^4.16.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "peerDependencies": {
    "express": ">=4",
    "hono": ">=4"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  }
}
