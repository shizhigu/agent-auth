{
  "name": "vouch-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Vouch — identity infrastructure for AI agents. Monorepo root.",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspace=agent-auth",
    "test:chaos": "npm run test:chaos --workspace=agent-auth",
    "bench": "npm run bench --workspace=agent-auth"
  }
}
